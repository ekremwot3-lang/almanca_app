#:kivy 2.0

<QuizRoot>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: 'Almanca Fiil \u00c7ekim Testi'
        font_size: '22sp'
        bold: True
        size_hint_y: None
        height: dp(40)
        color: 0.1, 0.1, 0.1, 1

    Label:
        text: root.score_text
        size_hint_y: None
        height: dp(26)
        font_size: '15sp'
        color: 0.3, 0.3, 0.3, 1

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(170)
        padding: dp(12)
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: 0.93, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.verb_text
            font_size: '20sp'
            bold: True
            color: 0.05, 0.05, 0.4, 1
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'

        Label:
            text: root.mood_tense_text
            font_size: '15sp'
            color: 0.2, 0.2, 0.2, 1
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'

        Label:
            text: root.pronoun_text
            font_size: '28sp'
            bold: True
            color: 0.5, 0.05, 0.05, 1
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'

    TextInput:
        id: answer_input
        hint_text: '\u00c7ekimli fiili yaz\u0131n...'
        multiline: False
        font_size: '20sp'
        size_hint_y: None
        height: dp(50)
        on_text_validate: root.check_answer()

    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(10)

        Button:
            text: 'Kontrol Et'
            on_release: root.check_answer()
        Button:
            text: '\u0130pucu'
            on_release: root.show_hint()
        Button:
            text: 'Sonraki Soru'
            on_release: root.next_question()

    Label:
        text: root.feedback_text
        font_size: '16sp'
        color: root.feedback_color
        text_size: self.width, None
        halign: 'center'
        valign: 'top'
